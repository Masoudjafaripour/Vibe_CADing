---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Method from "../components/Method.astro";
import Gallery from "../components/Gallery.astro";
import Interactive from "../components/Interactive.astro";
import Explore from "../components/Explore.astro";
import Printability from "../components/Printability.astro";
import Simplify from "../components/Simplify.astro";
import Motion from "../components/Motion.astro";
import Engine from "../components/Engine.astro";
import Results from "../components/Results.astro";
import Status from "../components/Status.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Vibe-CADing: Conditional CAD Generation and Retrieval for a Text-to-CAD Design Pipeline"
  description="LLMs write the shape as code (CadQuery, build123d or GLSL). A C++ engine meshes it, checks it for 3D printing and feeds every flaw back until the part is valid. Live 3D demos, motion, results."
>
  <Nav />
  <main>
    <Hero />
    <Method />
    <Explore />
    <Printability />
    <Simplify />
    <Motion />
    <Engine />
    <Interactive />
    <Gallery />
    <Results />
    <Status />
  </main>
  <Footer />
</Layout>
