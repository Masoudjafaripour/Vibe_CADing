---
import { asset, blobUrl, gallery } from "../data/site";
import SectionHead from "./SectionHead.astro";

const filters = [
  ["all", "All"],
  ["sdf", "SDF / GLSL"],
  ["brep", "B-rep / CAD"],
];
---

<section id="gallery" class="border-b border-line">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHead fig="02 — OUTPUTS" title="From the repository." dim="Nothing staged.">
      Every image is a file checked into the repo. Each caption says who wrote the geometry code: an LLM, or a
      hand-written reference.
    </SectionHead>

    <div class="mt-8 flex border border-line font-mono text-[11px] tracking-[0.1em] uppercase sm:inline-flex" role="group" aria-label="Filter gallery">
      {filters.map(([key, label], i) => (
        <button type="button" data-filter={key} aria-pressed={i === 0 ? "true" : "false"}
          class="flex-1 border-r border-line px-4 py-2 text-muted transition-colors last:border-r-0 hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg">
          {label}
        </button>
      ))}
    </div>

    <div class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((item, i) => (
        <figure data-kind={item.kind} class="group flex flex-col bg-bg">
          <div class="relative overflow-hidden border-b border-line bg-panel">
            <img src={asset(item.image)} alt={`${item.title}: ${item.method}`} loading="lazy" width="480" height="360"
              class:list={["aspect-[4/3] w-full transition-transform duration-500 group-hover:scale-[1.03]",
                item.image.endsWith(".svg") ? "bg-white object-contain p-6" : "object-cover"]} />
            <span class="absolute top-2 left-2 bg-bg/85 px-1.5 py-0.5 font-mono text-[10px] tracking-[0.1em] text-muted">
              {String(i + 1).padStart(2, "0")} · <span class={item.kind === "sdf" ? "text-signal" : "text-cyan"}>{item.kind === "sdf" ? "SDF" : "B-REP"}</span>
            </span>
          </div>
          <figcaption class="flex flex-1 flex-col p-5">
            <h3 class="display text-xl font-semibold uppercase">{item.title}</h3>
            <p class="mt-1 font-mono text-[11px] text-muted">{item.method} · <span class="text-ink">{item.author}</span></p>
            {item.prompt && <p class="mt-3 border-l-2 border-line-strong pl-3 font-mono text-[11.5px] leading-relaxed">“{item.prompt}”</p>}
            <p class="mt-3 flex-1 text-[13px] leading-relaxed text-muted">{item.note}</p>
            <a href={blobUrl(item.source)} class="mt-4 truncate font-mono text-[11px] text-faint underline decoration-line underline-offset-4 hover:text-ink">{item.source}</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("#gallery [data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("#gallery [data-kind]");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      cards.forEach((card) => (card.hidden = btn.dataset.filter !== "all" && card.dataset.kind !== btn.dataset.filter));
    }),
  );
</script>
