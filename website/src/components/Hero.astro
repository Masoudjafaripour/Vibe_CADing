---
import { asset, author, repoUrl } from "../data/site";
import Models3D from "./Models3D.astro";
---

<section id="top" class="grid-paper border-b border-line">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 pt-12 pb-14 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:pt-16">
    <div class="flex flex-col justify-center">
      <p class="fig mb-6">FIG. 00 — TEXT → GEOMETRY</p>
      <h1 class="display text-5xl leading-[0.95] font-semibold uppercase sm:text-6xl xl:text-7xl">
        Text in.<br />Printable<br /><span class="text-signal">geometry</span> out.
      </h1>
      <p class="mt-6 max-w-md text-[15px] leading-relaxed text-muted">
        <strong class="font-medium text-ink">Vibe-CADing</strong> has an LLM write the shape as code: CAD code for B-rep
        solids, or GLSL for implicit surfaces. A C++ engine meshes it, checks it for 3D printing and sends every flaw back to
        the model until the part is valid.
      </p>

      <div class="frame mt-8 bg-panel/80 p-4 font-mono text-[13px] leading-relaxed">
        <span class="corners"></span>
        <p class="text-faint">$ python demo.py --print-check --stl \</p>
        <p class="pl-4"><span class="text-cyan">--prompt</span> "a spur gear with 16 teeth, a keyed bore and six lightening holes"<span class="caret ml-1"></span></p>
        <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 border-t border-line pt-3 text-[12px] sm:grid-cols-4">
          <p><span class="text-faint">attempt</span> 1/3</p>
          <p><span class="text-faint">tris</span> 64,248</p>
          <p><span class="text-faint">genus</span> 7</p>
          <p class="text-ok">● printable</p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#pipeline" class="bg-signal px-5 py-2.5 font-mono text-[12px] font-medium tracking-[0.1em] text-white uppercase transition-opacity hover:opacity-90">How it works</a>
        <a href={repoUrl} class="border border-line-strong px-5 py-2.5 font-mono text-[12px] tracking-[0.1em] uppercase transition-colors hover:border-ink">Read the code</a>
        <a href={asset("media/vibe_cading_report.pdf")} class="border border-line-strong px-5 py-2.5 font-mono text-[12px] tracking-[0.1em] uppercase transition-colors hover:border-ink">Report (PDF)</a>
      </div>
      <p class="mt-6 font-mono text-[11px] tracking-[0.1em] text-faint uppercase">
        by <a href={author.url} class="text-muted underline decoration-line underline-offset-4 hover:text-ink">{author.name}</a>
      </p>
    </div>

    <Models3D />
  </div>
</section>
