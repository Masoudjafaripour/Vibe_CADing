---
import { treeUrl } from "../data/site";
import SectionHead from "./SectionHead.astro";

const steps = [
  ["Prompt", "Text, or an edit to an existing shape."],
  ["LLM", "Local Qwen or any OpenAI-compatible API."],
  ["Program", "CadQuery / build123d, or GLSL sdf(p)."],
  ["Run", "Subprocess + timeout: OpenCascade or GPU."],
  ["Check", "Tracebacks, compile logs, renders, printability."],
  ["Part", "STEP, STL, glTF, PNG / GIF."],
];

const harnesses = [
  {
    tag: "B-REP",
    title: "CAD-code harness",
    path: "src/CAD_Harness",
    points: [
      "The LLM writes CadQuery or build123d code that assigns the part to result.",
      "Runs in a subprocess and exports STEP through the OpenCascade kernel.",
      "Tracebacks go back into the prompt (CADCodeVerify-style), up to max_retries.",
    ],
  },
  {
    tag: "SDF",
    title: "SDF harness (GLSL)",
    path: "src/CAD_Harness/sdf",
    points: [
      "The LLM writes float sdf(vec3 p) with a shared primitive library.",
      "A headless OpenGL sphere tracer renders it; the C++ engine meshes and checks it.",
      "Compile errors, empty or off-frame shapes and printability failures trigger repair.",
    ],
  },
  {
    tag: "B-REP",
    title: "LLM → JSON → pythonOCC",
    path: "src/B-rep",
    points: [
      "Qwen2.5-3B turns a prompt into a spec such as {\"type\": \"cube\", \"size\": 5}.",
      "pythonOCC builds sketch → wire → face → extruded solid → STEP / IGES.",
      "Robust for primitives, limited to what the schema can express.",
    ],
  },
];

const supporting = [
  ["Text → image → SVG", "Stable Diffusion + ControlNet (Canny), then OpenCV contour tracing", "src/pipeline"],
  ["PixelCNN 2D CAD grids", "Masked convolutions over CAD token grids", "src/AR"],
  ["CLIP retrieval", "ViT-B/32 ranks rendered meshes against a text query", "src/CLIP"],
];

const reps = [
  ["Stores", "a function (code)", "triangles", "exact faces, edges, NURBS"],
  ["Size", "KB of code", "large", "medium"],
  ["Smooth blends", "trivial", "hard", "hard (fillets)"],
  ["Exact dims / STEP", "no", "approximate", "yes"],
  ["Best for", "organic forms", "rendering, printing", "engineering CAD"],
];
---

<section id="pipeline" class="border-b border-line">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHead fig="METHOD" title="Geometry as code">
      The model never outputs geometry directly. It writes a <em class="text-ink">program</em>, which is treated as
      untrusted code: run in isolation, checked, and returned with its error until it passes. Three harnesses share this
      loop and differ only in what the program describes.
    </SectionHead>

    <!-- schematic -->
    <div class="frame mt-10 bg-panel/50 p-4 sm:p-6">
      <span class="corners"></span>
      <ol class="grid gap-px bg-line sm:grid-cols-3 lg:grid-cols-6">
        {steps.map(([title, body], i) => (
          <li class="bg-bg p-4">
            <p class="font-mono text-[11px] text-signal">{String(i + 1).padStart(2, "0")}</p>
            <p class="display mt-1 text-lg font-semibold">{title}</p>
            <p class="mt-1 text-[13px] leading-snug text-muted">{body}</p>
          </li>
        ))}
      </ol>
      <div class="mt-4 grid gap-3 font-mono text-[11px] sm:grid-cols-2">
        <p class="border-l-2 border-bad py-1 pl-3 text-muted"><span class="text-bad">↺ REPAIR 05 → 02</span>&nbsp; the model gets its own code back with the error, and tries again (0–3 rounds)</p>
        <p class="border-l-2 border-ok py-1 pl-3 text-muted"><span class="text-ok">✎ REFINE 06 → 01</span>&nbsp; a new instruction (“make the wings larger”) edits the last valid program</p>
      </div>
    </div>

    <!-- harnesses -->
    <div class="mt-10 grid gap-px border border-line bg-line lg:grid-cols-3">
      {harnesses.map((h) => (
        <article class="flex flex-col bg-bg p-6">
          <div class="flex items-center justify-between gap-2">
            <h3 class="display text-xl font-semibold">{h.title}</h3>
            <span class:list={["font-mono text-[10px] tracking-[0.14em]", h.tag === "SDF" ? "text-signal" : "text-cyan"]}>{h.tag}</span>
          </div>
          <ul class="mt-4 flex-1 space-y-2 text-[13px] leading-relaxed text-muted">
            {h.points.map((p) => <li class="flex gap-2"><span class="text-faint">—</span><span>{p}</span></li>)}
          </ul>
          <a href={treeUrl(h.path)} class="mt-5 font-mono text-[11px] text-muted underline decoration-line underline-offset-4 hover:text-ink">{h.path} ↗</a>
        </article>
      ))}
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="label mb-3">Supporting models</p>
        <ul class="border-t border-line">
          {supporting.map(([name, what, path]) => (
            <li class="border-b border-line py-3">
              <a href={treeUrl(path)} class="display text-lg font-semibold hover:text-signal">{name}</a>
              <p class="text-[13px] text-muted">{what}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0">
        <p class="label mb-3">Why several representations?</p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[30rem] border-t border-line text-left text-[13px]">
            <thead class="font-mono text-[10px] tracking-[0.14em] text-faint uppercase">
              <tr class="border-b border-line">
                <th class="py-2 pr-3 font-normal"></th>
                <th class="px-3 py-2 font-normal text-signal">SDF (GLSL)</th>
                <th class="px-3 py-2 font-normal">Mesh</th>
                <th class="py-2 pl-3 font-normal text-cyan">B-rep (CAD code)</th>
              </tr>
            </thead>
            <tbody>
              {reps.map(([k, a, b, c]) => (
                <tr class="border-b border-line">
                  <th class="py-2.5 pr-3 font-medium">{k}</th>
                  <td class="px-3 py-2.5 text-muted">{a}</td>
                  <td class="px-3 py-2.5 text-muted">{b}</td>
                  <td class="py-2.5 pl-3 text-muted">{c}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
