---
import { asset, blobUrl } from "../data/site";
import { SHAPES } from "../scripts/sdf-viewer";
import SectionHead from "./SectionHead.astro";

const shapes = Object.entries(SHAPES).map(([key, s]) => ({
  key,
  label: s.label,
  path: s.path,
  bytes: new TextEncoder().encode(s.code).length,
  lines: s.code.trimEnd().split("\n").length,
  code: s.code,
}));
const btn = "border-r border-line px-2.5 py-1.5 font-mono text-[11px] tracking-[0.08em] text-muted uppercase transition-colors last:border-r-0 hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg";
---

<section id="interactive" class="grid-paper border-b border-line">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHead fig="03 — LIVE" title="Two representations," dim="running in your browser.">
      Left: GLSL shapes compiled live with a WebGL2 port of the harness's sphere tracer. Right: the CadQuery plate
      tessellated from its STEP file, with the solid's B-rep edges.
    </SectionHead>

    <div class="mt-10 grid gap-5 lg:grid-cols-[1.35fr_1fr]">
      <article class="frame flex min-w-0 flex-col bg-panel/70">
        <span class="corners"></span>
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-3 py-2">
          <span class="font-mono text-[11px] tracking-[0.1em] text-muted uppercase">Viewport 02 — <span class="text-signal">SDF</span> sphere tracing</span>
          <div class="flex border border-line" role="group" aria-label="Choose shape" id="sdf-shapes">
            {shapes.map((s, i) => (
              <button type="button" data-shape={s.key} aria-pressed={i === 0 ? "true" : "false"} class={btn}>{s.label}</button>
            ))}
          </div>
        </div>
        <div class="relative">
          <canvas id="sdf-canvas" class="block aspect-[4/3] w-full cursor-grab touch-none data-[dragging]:cursor-grabbing" aria-label="Interactive 3D view of the selected GLSL shape"></canvas>
          <img id="sdf-fallback" hidden src={asset("media/dragon_gpt4o.gif")} alt="Dragon turntable (WebGL2 unavailable)" class="aspect-[4/3] w-full object-cover" />
          <p id="sdf-error" hidden class="absolute inset-x-3 bottom-3 border border-bad bg-bg p-3 font-mono text-xs text-bad"></p>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line px-3 py-2 font-mono text-[11px] text-muted uppercase">
          <label class="inline-flex cursor-pointer items-center gap-1.5"><input id="sdf-rotate" type="checkbox" class="accent-[var(--signal)]" checked /> Rotate</label>
          <label class="inline-flex cursor-pointer items-center gap-1.5"><input id="sdf-shadows" type="checkbox" class="accent-[var(--signal)]" checked /> Shadows</label>
          <button id="sdf-reset" type="button" class="uppercase underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
          <span id="sdf-meta" class="ml-auto text-ink"></span>
        </div>
        <details class="group border-t border-line">
          <summary class="cursor-pointer list-none px-3 py-2 font-mono text-[11px] tracking-[0.1em] text-muted uppercase select-none hover:text-ink">
            <span class="mr-1.5 inline-block transition-transform group-open:rotate-90">›</span> Source: this GLSL is the whole model
          </summary>
          {shapes.map((s, i) => (
            <div data-code={s.key} hidden={i !== 0}>
              <pre class="max-h-80 overflow-auto border-t border-line bg-bg p-4 font-mono text-[11.5px] leading-relaxed"><code>{s.code}</code></pre>
              <a href={blobUrl(s.path)} class="block border-t border-line px-3 py-2 font-mono text-[11px] text-faint hover:text-ink">{s.path} · {s.bytes.toLocaleString("en-US")} bytes · {s.lines} lines</a>
            </div>
          ))}
        </details>
      </article>

      <article class="frame flex min-w-0 flex-col bg-panel/70">
        <span class="corners"></span>
        <div class="flex items-center justify-between gap-2 border-b border-line px-3 py-2">
          <span class="font-mono text-[11px] tracking-[0.1em] text-muted uppercase">Viewport 03 — <span class="text-cyan">B-rep</span> from STEP</span>
          <button id="brep-reset" type="button" class="font-mono text-[11px] tracking-[0.1em] text-muted uppercase underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
        </div>
        <canvas id="brep-canvas" data-src={asset("models/plate.json")} class="block aspect-[4/3] w-full flex-1 cursor-grab touch-none" aria-label="Interactive 3D view of the CadQuery mounting plate"></canvas>
        <div class="border-t border-line px-3 py-3 font-mono text-[11px] leading-relaxed text-muted">
          <p id="brep-stats" class="text-ink">Loading…</p>
          <p class="mt-2">PROMPT (Qwen3-8B) “a 40x20x5mm mounting plate with two 4mm holes 15mm either side of center and 2mm filleted corners”</p>
          <a href={blobUrl("src/CAD_Harness/cadquery/plate.step")} class="mt-2 inline-block underline decoration-line underline-offset-4 hover:text-ink">src/CAD_Harness/cadquery/plate.step</a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { SHAPES, SdfViewer } from "../scripts/sdf-viewer";

  const canvas = document.getElementById("sdf-canvas") as HTMLCanvasElement;
  const errorBox = document.getElementById("sdf-error")!;
  const meta = document.getElementById("sdf-meta")!;
  let viewer: SdfViewer | null = null;

  try {
    viewer = new SdfViewer(canvas);
    viewer.onError = (msg) => {
      errorBox.textContent = msg;
      errorBox.hidden = false;
    };
  } catch {
    canvas.hidden = true;
    document.getElementById("sdf-fallback")!.hidden = false;
  }

  const select = (key: string) => {
    errorBox.hidden = true;
    viewer?.load(SHAPES[key].code);
    const bytes = new TextEncoder().encode(SHAPES[key].code).length;
    meta.textContent = `${(bytes / 1024).toFixed(1)} KB of GLSL`;
    document.querySelectorAll<HTMLButtonElement>("#sdf-shapes [data-shape]").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.shape === key)),
    );
    document.querySelectorAll<HTMLElement>("[data-code]").forEach((el) => (el.hidden = el.dataset.code !== key));
  };
  document.querySelectorAll<HTMLButtonElement>("#sdf-shapes [data-shape]").forEach((b) =>
    b.addEventListener("click", () => select(b.dataset.shape!)),
  );
  select(Object.keys(SHAPES)[0]);

  const rotate = document.getElementById("sdf-rotate") as HTMLInputElement;
  if (viewer) rotate.checked = viewer.autoRotate;
  rotate.addEventListener("change", () => viewer && (viewer.autoRotate = rotate.checked));
  const shadows = document.getElementById("sdf-shadows") as HTMLInputElement;
  shadows.addEventListener("change", () => {
    if (!viewer) return;
    viewer.shadows = shadows.checked;
    viewer.markDirty();
  });
  document.getElementById("sdf-reset")!.addEventListener("click", () => viewer?.resetView());

  // three.js is only fetched when the B-rep viewer scrolls near the viewport
  const brepCanvas = document.getElementById("brep-canvas") as HTMLCanvasElement;
  const stats = document.getElementById("brep-stats")!;
  const io = new IntersectionObserver(
    async ([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      try {
        const { mountBrepViewer } = await import("../scripts/brep-viewer");
        const brep = await mountBrepViewer(brepCanvas, brepCanvas.dataset.src!);
        stats.textContent = brep.stats;
        document.getElementById("brep-reset")!.addEventListener("click", brep.reset);
      } catch (err) {
        stats.textContent = `Could not load the 3D model: ${err}`;
      }
    },
    { rootMargin: "300px" },
  );
  io.observe(brepCanvas);
</script>
