---
import { runs } from "../data/site";
import SectionHead from "./SectionHead.astro";

const passes = runs.filter((r) => r.outcome === "pass").length;
const limits = [
  "The checks catch broken code and unprintable parts, not wrong shapes: a valid program can still miss the prompt.",
  "Small local models (Qwen3-8B, Qwen2.5-Coder-7B) often repeat the same mistake through every repair round.",
  "SDF output is visual geometry, not dimensioned CAD: no STEP export or exact tolerances.",
  "No quantitative benchmark yet; a vision critic comparing renders with the prompt is the natural next step.",
];
---

<section id="results" class="border-b border-line">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <SectionHead fig="RESULTS" title="Recorded runs" dim={`— ${passes} of ${runs.length} valid`}>
      Individual, qualitative runs recorded in the repository. This is <em class="text-ink">not a benchmark</em>: the
      failures are listed on purpose, and the main limitations follow.
    </SectionHead>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[44rem] border-t border-line-strong text-left text-[13px]">
        <thead class="font-mono text-[10px] tracking-[0.14em] text-faint uppercase">
          <tr class="border-b border-line">
            <th class="py-2 pr-3 font-normal">Harness</th><th class="px-3 py-2 font-normal">Model</th><th class="px-3 py-2 font-normal">Task</th>
            <th class="px-3 py-2 font-normal">Outcome</th><th class="py-2 pl-3 font-normal">Detail</th>
          </tr>
        </thead>
        <tbody>
          {runs.map((r) => (
            <tr class="border-b border-line">
              <td class="py-3 pr-3"><span class:list={["mr-2 font-mono text-[10px] tracking-[0.12em]", r.kind === "sdf" ? "text-signal" : "text-cyan"]}>{r.kind === "sdf" ? "SDF" : "B-REP"}</span>{r.harness}</td>
              <td class="px-3 py-3 font-medium whitespace-nowrap">{r.model}</td>
              <td class="px-3 py-3 text-muted">{r.task}</td>
              <td class:list={["px-3 py-3 font-mono text-[11px] uppercase", r.outcome === "pass" ? "text-ok" : "text-bad"]}>{r.outcome === "pass" ? "● valid" : "✕ failed"}</td>
              <td class="py-3 pl-3 text-muted">{r.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10">
      <p class="label mb-3">Limitations</p>
      <ul class="grid gap-px border border-line bg-line md:grid-cols-2">
        {limits.map((l, i) => (
          <li class="flex gap-3 bg-bg p-4 text-[13px] leading-relaxed text-muted"><span class="font-mono text-[11px] text-warn">L{i + 1}</span>{l}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
