---
import { author, bibtex, repoUrl } from "../data/site";
---

<section id="cite" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr]">
    <div class="min-w-0">
      <p class="eyebrow mb-3">Get started</p>
      <h2 class="section-title">Run it yourself</h2>
      <p class="mt-3 text-muted">The SDF demo runs without any LLM; add an API key to generate new shapes.</p>
      <pre class="card mt-5 overflow-x-auto p-4 font-mono text-[12px] leading-relaxed"><code>git clone {repoUrl}
cd Vibe_CADing/src/CAD_Harness/sdf
pip install -r requirements.txt
python demo.py --example snowman --gif

export OPENAI_API_KEY=sk-...
python demo.py --backend openai --model gpt-4o \
  --prompt "a stylized dragon" --gif</code></pre>
    </div>
    <div class="min-w-0">
      <p class="eyebrow mb-3">Citation</p>
      <h2 class="section-title">Cite this project</h2>
      <div class="card relative mt-5">
        <button
          id="copy-bibtex"
          type="button"
          class="absolute top-3 right-3 rounded-lg border border-line bg-surface px-2.5 py-1 text-xs text-muted transition-colors hover:text-ink"
        >Copy</button>
        <pre class="overflow-x-auto p-4 pr-20 font-mono text-[12px] leading-relaxed"><code id="bibtex">{bibtex}</code></pre>
      </div>
    </div>
  </div>
</section>

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-8 text-sm text-muted sm:px-6">
    <p>© 2025–2026 <a href={author.url} class="hover:text-ink">{author.name}</a> · MIT License</p>
    <a href={repoUrl} class="hover:text-ink">github.com/Masoudjafaripour/Vibe_CADing</a>
  </div>
</footer>

<script>
  const btn = document.getElementById("copy-bibtex")!;
  btn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(document.getElementById("bibtex")!.textContent ?? "");
      btn.textContent = "Copied";
    } catch {
      btn.textContent = "Select & copy";
    }
    setTimeout(() => (btn.textContent = "Copy"), 1600);
  });
</script>
