---
import models from "../../../src/CAD_Harness/sdf/assets/gallery_3d/index.json";
import { asset, blobUrl } from "../data/site";

const verdictStyle: Record<string, string> = {
  printable: "bg-ok-soft text-ok",
  "printable with supports": "bg-warn-soft text-warn",
  "not printable": "bg-bad-soft text-bad",
};
---

<section id="models3d" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <p class="eyebrow mb-3">Text-to-CAD in 3D</p>
  <h2 class="section-title">Eight prompts, eight printable meshes</h2>
  <p class="mt-3 max-w-3xl text-muted">
    Each model below started as a text prompt. An LLM wrote it as GLSL, and the C++ engine then meshed it, simplified it
    (QEM, keeping holes and separate parts), coloured it from the shape's own <code class="font-mono text-[13px]">sdf_color()</code>,
    checked it for 3D printing and exported it as glTF. Drag to orbit, scroll to zoom.
  </p>

  <div class="mt-10 grid gap-5 lg:grid-cols-[1.5fr_1fr]">
    <article class="card min-w-0 overflow-hidden bg-bg">
      <div class="flex flex-wrap gap-1 border-b border-line p-3" role="group" aria-label="Choose model" id="m3d-buttons">
        {models.map((m, i) => (
          <button
            type="button"
            data-model={m.name}
            aria-pressed={i === 0 ? "true" : "false"}
            class="rounded-lg px-2.5 py-1 text-xs text-muted capitalize transition-colors hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg"
          >
            {m.name}
          </button>
        ))}
      </div>
      <div class="relative">
        <canvas id="m3d-canvas" data-base={asset("media/gallery_3d/")} class="block aspect-[4/3] w-full cursor-grab touch-none" aria-label="Interactive 3D view of the selected model"></canvas>
        <p id="m3d-status" class="pointer-events-none absolute inset-x-0 bottom-3 text-center font-mono text-xs text-muted">Loading…</p>
      </div>
    </article>

    <div class="min-w-0">
      {models.map((m, i) => (
        <article data-info={m.name} hidden={i !== 0} class="card p-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-semibold capitalize">{m.name}</h3>
            {m.print && <span class:list={["tag", verdictStyle[m.print.verdict]]}>{m.print.verdict}</span>}
          </div>
          <p class="mt-3 rounded-lg bg-surface-2 px-3 py-2 font-mono text-[12px] leading-relaxed">“{m.prompt}”</p>
          <p class="mt-2 text-xs text-muted">GLSL written by {m.author}</p>
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl bg-surface-2 p-3"><dt class="text-xs text-muted">Size</dt><dd class="font-medium">{m.size_mm.map((v: number) => v.toFixed(0)).join(" × ")} mm</dd></div>
            <div class="rounded-xl bg-surface-2 p-3"><dt class="text-xs text-muted">Topology</dt><dd class="font-medium">{m.shells} shell{m.shells === 1 ? "" : "s"} · genus {m.genus}</dd></div>
            <div class="rounded-xl bg-surface-2 p-3"><dt class="text-xs text-muted">Full mesh</dt><dd class="font-medium">{(m.triangles_full / 1000).toFixed(0)}k triangles</dd></div>
            <div class="rounded-xl bg-surface-2 p-3"><dt class="text-xs text-muted">Shown</dt><dd class="font-medium" data-shown>12k triangles</dd></div>
          </dl>
          {m.print && m.print.issues.length > 0 && (
            <ul class="mt-4 space-y-1.5 text-xs leading-relaxed text-muted">
              {m.print.issues.map((t: string) => <li class="flex gap-2"><span class="mt-1.5 size-1 shrink-0 rounded-full bg-warn"></span><span>{t}</span></li>)}
            </ul>
          )}
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px]">
            <a href={asset(`media/gallery_3d/${m.name}.glb`)} download class="underline decoration-line underline-offset-4 hover:text-ink">download .glb</a>
            <a href={blobUrl(`src/CAD_Harness/sdf/gallery/${m.name}.glsl`)} class="text-muted underline decoration-line underline-offset-4 hover:text-ink">GLSL source</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("m3d-canvas") as HTMLCanvasElement;
  const status = document.getElementById("m3d-status")!;
  const base = canvas.dataset.base!;
  const buttons = document.querySelectorAll<HTMLButtonElement>("#m3d-buttons [data-model]");
  let viewer: { load(url: string): Promise<{ triangles: number }> } | null = null;

  async function show(name: string) {
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.model === name)));
    document.querySelectorAll<HTMLElement>("[data-info]").forEach((el) => (el.hidden = el.dataset.info !== name));
    if (!viewer) return;
    status.textContent = "Loading…";
    try {
      const { triangles } = await viewer.load(`${base}${name}.glb`);
      status.textContent = "";
      const shown = document.querySelector<HTMLElement>(`[data-info="${name}"] [data-shown]`);
      if (shown) shown.textContent = `${(triangles / 1000).toFixed(1)}k triangles`;
    } catch (err) {
      status.textContent = `Could not load the model: ${err}`;
    }
  }
  buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.model!)));

  // three.js and the first model load only when the section scrolls near the viewport
  const io = new IntersectionObserver(
    async ([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      const { mountGlbViewer } = await import("../scripts/glb-viewer");
      viewer = mountGlbViewer(canvas);
      show(buttons[0].dataset.model!);
    },
    { rootMargin: "300px" },
  );
  io.observe(canvas);
</script>
