---
// The hero viewport: the 8 text-to-CAD gallery shapes as coloured glTF meshes
// (C++ engine: marching cubes -> QEM simplification -> printability -> glTF).
import models from "../../../src/CAD_Harness/sdf/assets/gallery_3d/index.json";
import { asset, blobUrl } from "../data/site";

const verdictColor: Record<string, string> = {
  printable: "text-ok",
  "printable with supports": "text-warn",
  "not printable": "text-bad",
};
---

<div id="models3d" class="min-w-0">
  <div class="frame bg-panel/60">
    <span class="corners"></span>
    <div class="flex items-center justify-between border-b border-line px-3 py-2 font-mono text-[11px] tracking-[0.1em] text-muted uppercase">
      <span>Viewport 01 — <span id="hud-file" class="text-ink">{models[0].name}.glb</span></span>
      <span class="hidden sm:inline">Persp · Y-up · mm</span>
    </div>
    <div class="relative">
      <canvas id="m3d-canvas" data-base={asset("media/gallery_3d/")} class="block aspect-[5/4] w-full cursor-grab touch-none" aria-label="Interactive 3D view of the selected model"></canvas>
      <div class="pointer-events-none absolute top-3 left-3 space-y-0.5 font-mono text-[11px] text-muted">
        <p>TRIS <span id="hud-tris" class="text-ink">—</span></p>
        <p>SHELLS <span id="hud-shells" class="text-ink">—</span> · GENUS <span id="hud-genus" class="text-ink">—</span></p>
        <p>VERDICT <span id="hud-verdict">—</span></p>
      </div>
      <svg class="pointer-events-none absolute right-3 bottom-3 size-14" viewBox="0 0 56 56" aria-hidden="true">
        <line x1="16" y1="40" x2="44" y2="40" stroke="#ff5252" stroke-width="1.5" /><text x="47" y="43" font-size="9" fill="#ff5252" font-family="IBM Plex Mono">X</text>
        <line x1="16" y1="40" x2="16" y2="12" stroke="#3ddc84" stroke-width="1.5" /><text x="13" y="9" font-size="9" fill="#3ddc84" font-family="IBM Plex Mono">Y</text>
        <line x1="16" y1="40" x2="5" y2="51" stroke="#4cc3ff" stroke-width="1.5" /><text x="0" y="56" font-size="9" fill="#4cc3ff" font-family="IBM Plex Mono">Z</text>
      </svg>
      <p id="m3d-status" class="pointer-events-none absolute inset-x-0 top-1/2 text-center font-mono text-xs text-muted">Loading…</p>
    </div>
    <div class="flex items-center gap-2 border-t border-line px-3 py-2 font-mono text-[11px] text-muted">
      <span class="h-2 border-l border-line-strong"></span>
      <span class="h-px flex-1 bg-line-strong"></span>
      <span id="hud-dims" class="text-ink">—</span>
      <span class="h-px flex-1 bg-line-strong"></span>
      <span class="h-2 border-r border-line-strong"></span>
    </div>
    <div class="grid grid-cols-4 border-t border-line sm:grid-cols-8" id="m3d-buttons" role="group" aria-label="Choose model">
      {models.map((m, i) => (
        <button type="button" data-model={m.name} aria-pressed={i === 0 ? "true" : "false"}
          class="border-r border-b border-line px-2 py-2 font-mono text-[11px] tracking-[0.08em] text-muted uppercase transition-colors hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg sm:border-b-0 [&:nth-child(4n)]:border-r-0 sm:[&:nth-child(4n)]:border-r sm:last:border-r-0">
          {m.name}
        </button>
      ))}
    </div>
  </div>

  {models.map((m, i) => (
    <div data-info={m.name} hidden={i !== 0} class="mt-3 grid gap-x-6 gap-y-2 border-b border-line pb-3 font-mono text-[11px] text-muted sm:grid-cols-[1fr_auto]">
      <p class="leading-relaxed"><span class="text-faint">PROMPT</span> <span class="text-ink">“{m.prompt}”</span></p>
      <p class="sm:text-right">
        <span class:list={[verdictColor[m.print?.verdict ?? ""], "uppercase"]}>{m.print?.verdict}</span>
        <span class="text-faint"> · GLSL by {m.author.replace(" (Opus 5.5)", "")}</span>
      </p>
      {m.print && m.print.issues.length > 0 && (
        <p class="leading-relaxed sm:col-span-2"><span class="text-faint">NOTES</span> {m.print.issues.join(" ").replaceAll("mm^2", "mm²")}</p>
      )}
      <p class="sm:col-span-2">
        <a href={asset(`media/gallery_3d/${m.name}.glb`)} download class="text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink">download .glb</a>
        <span class="text-faint"> · </span>
        <a href={blobUrl(`src/CAD_Harness/sdf/gallery/${m.name}.glsl`)} class="underline decoration-line underline-offset-4 hover:text-ink">GLSL source</a>
      </p>
    </div>
  ))}
</div>

<script>
  import models from "../../../src/CAD_Harness/sdf/assets/gallery_3d/index.json";

  const canvas = document.getElementById("m3d-canvas") as HTMLCanvasElement;
  const status = document.getElementById("m3d-status")!;
  const byName = Object.fromEntries(models.map((m) => [m.name, m]));
  const set = (id: string, text: string) => (document.getElementById(id)!.textContent = text);
  let viewer: { load(url: string): Promise<{ triangles: number }> } | null = null;

  async function show(name: string) {
    const m = byName[name];
    document.querySelectorAll<HTMLButtonElement>("#m3d-buttons [data-model]").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.model === name)));
    document.querySelectorAll<HTMLElement>("[data-info]").forEach((el) => (el.hidden = el.dataset.info !== name));
    set("hud-file", `${name}.glb`);
    set("hud-dims", m.size_mm.map((v: number) => v.toFixed(0)).join(" × ") + " mm");
    set("hud-shells", String(m.shells));
    set("hud-genus", String(m.genus));
    const verdict = m.print?.verdict ?? "—";
    const v = document.getElementById("hud-verdict")!;
    v.textContent = verdict;
    v.className = verdict === "printable" ? "text-ok" : verdict === "not printable" ? "text-bad" : "text-warn";
    if (!viewer) return;
    status.textContent = "Loading…";
    try {
      const { triangles } = await viewer.load(`${canvas.dataset.base}${name}.glb`);
      status.textContent = "";
      set("hud-tris", `${triangles.toLocaleString("en-US")} of ${m.triangles_full.toLocaleString("en-US")}`);
    } catch (err) {
      status.textContent = `Could not load the model: ${err}`;
    }
  }
  document.querySelectorAll<HTMLButtonElement>("#m3d-buttons [data-model]").forEach((b) =>
    b.addEventListener("click", () => show(b.dataset.model!)));
  show(models[0].name);

  import("../scripts/glb-viewer").then(({ mountGlbViewer }) => {
    viewer = mountGlbViewer(canvas);
    show(document.querySelector<HTMLButtonElement>('#m3d-buttons [aria-pressed="true"]')!.dataset.model!);
  });
</script>
